// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["views"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// GUIDELINE TEMPLATE SYSTEM
// ============================================

model GuidelineTemplate {
  id        String   @id @default(cuid())
  name      String   @unique // "Tap Elite 2026", "WTF Standard"
  pdfUrl    String? // Uploaded PDF path/URL
  content   String?  @db.Text // Markdown/HTML content for dynamic generation
  createdAt DateTime @default(now())

  divisions   Division[]
  tournaments Tournament[]
}

model Division {
  id           String @id @default(cuid())
  name         String // "Cadet", "Junior", "Senior"
  minAge       Int // Minimum age for this division
  maxAge       Int // Maximum age for this division
  displayOrder Int    @default(0) // For sorted display

  templateId String
  template   GuidelineTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  categories WeightCategory[]

  @@index([templateId])
}

model WeightCategory {
  id        String @id @default(cuid())
  name      String // "FIN", "Under 58kg"
  gender    String // "Male", "Female", "Both"
  minWeight Float // Minimum weight (inclusive)
  maxWeight Float // Maximum weight (exclusive, 999 for "and over")

  minHeight    Float? @default(0) // Minimum height in cm
  maxHeight    Float? @default(0) // Maximum height in cm
  displayOrder Int    @default(0)

  // Poomsae / Kyorugi Distinction
  type         String  @default("KYORUGI") // "KYORUGI", "POOMSAE"
  subtype      String  @default("INDIVIDUAL") // "INDIVIDUAL", "PAIR", "TEAM"
  poomsaeForms String? // Comma separated list of assigned forms
  belt         String? // Explicit belt requirement (e.g. "Yellow", "Black")

  divisionId String
  division   Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)
}

// ============================================
// TOURNAMENT
// ============================================

model Tournament {
  id                String    @id @default(cuid())
  name              String
  organizerId       String?
  organizer         User?     @relation("OrganizerTournaments", fields: [organizerId], references: [id])
  managers          User[]    @relation("TournamentManagers")
  startDate         DateTime  @default(now())
  venue             String? // Location of the tournament
  registrationStart DateTime? // When registration opens
  registrationEnd   DateTime? // When registration closes
  earlyBirdDeadline DateTime? // Early bird pricing deadline
  earlyBirdPrice    Float?    // Early bird registration price
  regularPrice      Float?    // Regular registration price
  guidelinePdfUrl   String? // URL to uploaded guideline PDF
  headerImageUrl    String? // URL to uploaded header image
  guidelinesText    String? @db.Text // Custom guidelines content
  status            String    @default("UPCOMING") // UPCOMING, ONGOING, COMPLETED, CANCELLED, RESCHEDULED
  tier              String    @default("J-2") // J-1, J-2, J-3, J-4
  dateTBA           Boolean   @default(false) // True if date not yet decided

  // Pricing
  showPricing       Boolean   @default(false) // Toggle pricing visibility for public/athletes
  categoryPricing   Json?     // Pricing per type+subtype combo, e.g. { "KYORUGI_INDIVIDUAL": { "earlyBird": 115, "regular": 145 } }

  // Xendit Payment Integration
  xenditEnabled     Boolean   @default(false) // Toggle online payments for this tournament
  xenditSecretKey   String?   // Encrypted Xendit API Secret Key

  // Guideline Template (optional - if set, auto-generates categories)
  guidelineTemplateId String?
  guidelineTemplate   GuidelineTemplate? @relation(fields: [guidelineTemplateId], references: [id])

  categories     Category[]
  managerInvites TournamentManagerInvite[]
  match_count    Int                       @default(0) // Cache matches count

  // Relations
  participatingClubs ClubEventParticipation[]

  smartProposals SmartProposal[]

  // Event Landing Page Relations
  guestRegistrations GuestRegistration[]
  promoCodes         PromoCode[]
  bulkRegistrations  BulkRegistration[]

  @@index([startDate])
  @@index([status])
}

model Category {
  id           String     @id @default(cuid())
  name         String
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  players      Player[]
  matches      Match[]
  poomsaeMatches PoomsaeMatch[]

  type         String  @default("KYORUGI") // "KYORUGI", "POOMSAE"
  subtype      String  @default("INDIVIDUAL") // "INDIVIDUAL", "PAIR", "TEAM"
  poomsaeForms String? // Assigned Forms

  court String? // Assigned Court Number

  skillLevel String? @default("Novice") // "Novice" or "Advance"
  deferFinals Boolean @default(true) // When true, finals are pushed to the end of the match schedule

  // Auto-Detection Rules (Copied from Template)
  minAge    Int?
  maxAge    Int?
  minWeight Float?
  maxWeight Float?
  minHeight Float?
  maxHeight Float?
  gender    String?
  belt      String? // Explicit belt requirement

  @@index([tournamentId])
}

// ============================================
// USER & PLAYER
// ============================================

model User {
  id      String @id // 5-digit random ID like "00123"
  clerkId String? @unique
  email   String @unique
  role    String @default("ATHLETE") // ATHLETE, CLUB_MASTER, ASSISTANT_CLUB_MASTER, ORGANIZER, MANAGER

  // Profile Fields
  imageUrl  String? // From Clerk
  name      String?
  birthDate DateTime? // For calculating age/division
  belt      String?
  gender    String?
  weight    Float?
  height    Float? // Height in cm for Toddler/Grade School divisions
  clubName  String?
  isVerified    Boolean @default(false) // Athlete License Status
  athleteNumber String? // Kukkiwon No. (Black Belt) or Athlete Card No. (other belts)
  country       String? // Country of the athlete

  // Relations
  players      Player[]
  club         Club?
  organization Organization? @relation("OrganizationOwner")

  // Tenant Membership (which org's website the user signed up through)
  organizationMemberId String?
  memberOrganization   Organization? @relation("OrganizationMembers", fields: [organizationMemberId], references: [id])

  // Organizer Relations
  createdTournaments Tournament[] @relation("OrganizerTournaments")
  managedTournaments Tournament[] @relation("TournamentManagers")

  // Co-Organizer Relation (allows non-owner to help manage an organization)
  coOrganizedOrganizations Organization[] @relation("OrganizationCoOrganizers")

  // API Keys
  apiKeys ApiKey[]

  // Push Notifications
  pushSubscriptions PushSubscription[]
  notifications     Notification[]

  // Timestamps
  createdAt DateTime? // Set when athlete card number is generated

  @@index([clubName])
  @@index([name])
  @@index([organizationMemberId])
}

model Player {
  id       String  @id // 5-digit ID like "00123"
  name     String
  gender   String  @default("Male")
  weight   Float?
  belt     String? @default("Black")
  height   Float? // Added for player specifics
  division String? // NEW: "Cadet", "Junior", etc.

  registrationStatus String  @default("PENDING") // PENDING, APPROVED, REJECTED
  skillLevel         String? @default("Novice")
  medal              String? // Gold, Silver, Bronze, QF, R16

  // Xendit Payment
  xenditInvoiceId    String? @unique // Xendit Invoice ID for webhook cross-reference
  xenditPaymentUrl   String?         // Checkout URL for player to pay
  paymentStatus      String  @default("UNPAID") // UNPAID, PENDING, PAID, EXPIRED

  // Poomsae Specifics
  teamId      String? // "1", "2", "A", "B" - assigned by Club Master
  poomsaeType String? // "INDIVIDUAL", "PAIR", "TEAM" - indicated by Athlete


  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  clubId String?
  club   Club?   @relation(fields: [clubId], references: [id])

  // Poomsae Relations
  poomsaeMatches    PoomsaeMatch[]
  guestRegistration GuestRegistration?

  // Check-in
  checkedIn   Boolean   @default(false)
  checkedInAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([userId])
  @@index([categoryId])
  @@index([clubId])
}

model Club {
  id       String   @id @default(cuid())
  name     String
  masterId String   @unique
  master   User     @relation(fields: [masterId], references: [id])
  students Player[]
  logoUrl  String?
  address  String?
  phone    String?

  // Organization Relation
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  // Relations
  participatingEvents ClubEventParticipation[]
  guestRegistrations  GuestRegistration[]
  bulkRegistrations   BulkRegistration[]
  affiliations        ClubAffiliation[]

  status String @default("PENDING") // PENDING, APPROVED, REJECTED

  @@index([name])
}

model Organization {
  id            String   @id @default(cuid())
  name          String
  ownerId       String   @unique
  owner         User     @relation("OrganizationOwner", fields: [ownerId], references: [id])
  establishedAt DateTime @default(now())
  logoUrl       String?
  emailBannerUrl String?
  status        String   @default("APPROVED") // PENDING, APPROVED, REJECTED

  // White-Label Branding
  slug           String?  @unique // "wotf", "tapelite" — routing key
  customDomain   String?  @unique // "wotf.org" — domain-based tenant detection
  primaryColor   String?           // "#C62828"
  secondaryColor String?           // "#1565C0"
  accentColor    String?           // "#FF9800"
  faviconUrl     String?
  heroImageUrl   String?
  tagline        String?           // "World of Taekwondo Federation"
  footerText     String?

  // Organization Details
  chairman     String?
  viceChairman String?
  address      String?
  contactEmail String?
  contactPhone String?
  website      String?

  // Co-Organizers (many-to-many - users who can help manage this organization)
  coOrganizers User[] @relation("OrganizationCoOrganizers")
  coOrganizerInvites CoOrganizerInvite[]

  // Tenant Members (users who signed up through this org's website)
  members User[] @relation("OrganizationMembers")

  clubs Club[]

  // Organization Affiliates
  parentOrganizationId    String?
  parentOrganizationStatus String? @default("NONE") // PENDING, APPROVED, REJECTED
  parentOrganization      Organization?  @relation("OrganizationAffiliates", fields: [parentOrganizationId], references: [id])
  affiliatedOrganizations Organization[] @relation("OrganizationAffiliates")

  announcements       Announcement[]
  promotionTests      PromotionTest[]
  seminars            Seminar[]
  clubAffiliations    ClubAffiliation[]
  platformInvoices    PlatformInvoice[]

  // Affiliation
  affiliationFee Float? // Annual fee in PHP, e.g. 5000.00

  // Affiliation Payment Config
  affiliationPaymentMethod String? @default("manual") // "manual" | "xendit"
  affiliationXenditEnabled Boolean @default(false)
  affiliationXenditSecretKey String? // Encrypted Xendit API Secret Key for affiliation
  affiliationQrCodeUrl     String? // Legacy single QR code
  affiliationBankName      String? // Legacy single bank
  affiliationBankAccountNo String? // Legacy single account
  affiliationBankAccountName String? // Legacy single account name
  affiliationInstructions  String? @db.Text // Additional payment instructions
  affiliationPaymentMethods Json? // Array of { id, label, bankName, accountNo, accountName, qrCodeUrl }

  defaultBeltFees Json? // e.g. {"whiteToPurple": 600, "blueToMaroon": 700, "brown": 800}
  feeDistributions Json? // e.g. { "affiliation": [{ name: "Platform", amount: 100 }, { name: "Rebate", amount: 400 }] }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Platform-level configuration (singleton — one row)
model PlatformConfig {
  id          String   @id @default("platform")
  platformFee Float    @default(0) // Fee per approved+paid registration across all event types
  bankName      String?
  accountName   String?
  accountNumber String?
  companyName   String?
  companyAddress String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// B2B Platform Tracking for monthly feature
model PlatformInvoice {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  billingMonth   String       // e.g., "March 2026"
  amountDue      Float
  status         String       @default("UNPAID") // UNPAID, PAID
  sentAt         DateTime     @default(now())
  paidAt         DateTime?
  
  @@unique([organizationId, billingMonth])
}

// Co-Organizer Invite (for inviting new users to become co-organizers)
model CoOrganizerInvite {
  id             String       @id @default(cuid())
  email          String
  token          String       @unique @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([email, organizationId])
  @@index([email])
}

model Announcement {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  content        String       @db.Text
  priority       String       @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  createdAt      DateTime     @default(now())
  expiresAt      DateTime?

  @@index([organizationId, createdAt])
}

model PromotionTest {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name                 String // "January 2026 Belt Test"
  description          String?   @db.Text
  testDate             DateTime
  registrationDeadline DateTime?
  venue                String?
  fee                  Float? // Registration fee
  status               String    @default("UPCOMING") // UPCOMING, OPEN, CLOSED, COMPLETED, CANCELLED

  // Xendit Payment Integration
  xenditEnabled     Boolean   @default(false)
  xenditSecretKey   String?   // Encrypted Xendit API Secret Key

  visibility String  @default("PRIVATE") // PRIVATE, PUBLIC
  bannerUrl  String? // Storage URL for banner image

  registrations      PromotionTestRegistration[]
  participatingClubs ClubEventParticipation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, testDate])
}

model PromotionTestRegistration {
  id              String        @id @default(cuid())
  promotionTestId String
  promotionTest   PromotionTest @relation(fields: [promotionTestId], references: [id], onDelete: Cascade)

  playerId    String? // If registered player
  playerName  String // Name for display
  clubName    String?
  currentBelt String
  targetBelt  String? // Made optional per user simplicity request
  age         Int?    // Snapshot of age at registration

  status        String @default("PENDING") // PENDING, APPROVED, PASSED, FAILED
  paymentStatus String @default("UNPAID") // UNPAID, PAID
  isJump        Boolean @default(false) // Skip a rank (e.g., White -> Orange instead of White -> Yellow)

  // Xendit Payment
  xenditInvoiceId  String? @unique
  xenditPaymentUrl String?

  createdAt DateTime @default(now())

  @@index([promotionTestId])
}

model Seminar {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name                 String
  description          String?   @db.Text
  startDate            DateTime
  endDate              DateTime?
  registrationDeadline DateTime?
  venue                String?
  fee                  Float?
  status               String    @default("UPCOMING") // UPCOMING, OPEN, CLOSED, COMPLETED, CANCELLED

  // Xendit Payment Integration
  xenditEnabled     Boolean   @default(false)
  xenditSecretKey   String?   // Encrypted Xendit API Secret Key

  visibility String  @default("PRIVATE") // PRIVATE, PUBLIC
  bannerUrl  String?
  paymentInstructions String? @db.Text // Instructions for payment (Bank details, GCash, etc.)
  paymentMethods      PaymentMethod[]

  registrations      SeminarRegistration[]
  participatingClubs ClubEventParticipation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, startDate])
}

model PaymentMethod {
  id        String   @id @default(cuid())
  seminarId String
  seminar   Seminar  @relation(fields: [seminarId], references: [id], onDelete: Cascade)

  type          String // "BANK", "EWALLET", "OTHER"
  name          String // "BDO", "GCash"
  accountName   String
  accountNumber String
  qrCodeUrl     String?

  createdAt DateTime @default(now())

  @@index([seminarId])
}

model SeminarRegistration {
  id        String  @id @default(cuid())
  seminarId String
  seminar   Seminar @relation(fields: [seminarId], references: [id], onDelete: Cascade)

  playerId    String?
  playerName  String
  clubName    String?
  belt        String? // Added
  age         Int?    // Added
  
  status        String @default("PENDING") // PENDING, APPROVED, REJECTED
  qrCodeToken   String?  @unique // Generated on approval, used for QR code at event

  // Xendit Payment
  xenditInvoiceId  String? @unique
  xenditPaymentUrl String?
  paymentStatus    String  @default("UNPAID") // UNPAID, PENDING, PAID, EXPIRED

  // Check-in
  checkedIn   Boolean   @default(false)
  checkedInAt DateTime?

  createdAt DateTime @default(now())

  @@index([seminarId])
}

// ============================================
// MATCH / BRACKET
// ============================================

model Match {
  id Int @id @default(autoincrement())

  category      String?
  categoryRef   Category? @relation(fields: [categoryRefId], references: [id])
  categoryRefId String?

  round Int

  player1 String
  player2 String

  winner String?

  nextMatchId   Int?
  nextMatch     Match?  @relation("Bracket", fields: [nextMatchId], references: [id])
  prevMatches   Match[] @relation("Bracket")
  nextMatchSlot String?

  matchId Int? // Display ID (1, 2, 3...) unique per tournament

  court String @default("Unassigned")

  // Scoring Fields
  r1_blue_score    Int @default(0)
  r1_red_score     Int @default(0)
  r2_blue_score    Int @default(0)
  r2_red_score     Int @default(0)
  r3_blue_score    Int @default(0)
  r3_red_score     Int @default(0)
  total_blue_score Int @default(0)
  total_red_score  Int @default(0)
  blue_gam_jeom    Int @default(0)
  red_gam_jeom     Int @default(0)
  blue_rounds_won  Int @default(0)
  red_rounds_won   Int @default(0)

  @@index([categoryRefId])
}

model PoomsaeMatch {
  id Int @id @default(autoincrement()) // Separate sequence from Match

  category      String?
  categoryRef   Category? @relation(fields: [categoryRefId], references: [id])
  categoryRefId String?

  round Int // 1=Prelim, 2=Semi, 3=Final

  matchId     Int? // Shared ID for all performances in this round group (e.g. 001)
  nextMatchId Int? // Points to the shared matchId of the next round group (e.g. 002)
  targetRank  Int? // The rank required to fill this slot (e.g. Rank 8 -> Perf #1)

  performanceNumber Int? // Official order (1, 2, 3...) within the group

  playerId String?
  player   Player? @relation(fields: [playerId], references: [id])

  // Team/Pair display fields (null for INDIVIDUAL — use player relation instead)
  displayName String? // "Katma Team A", "Katma Pair A" — team/pair display name
  memberIds   String? // "26828, 76251" — comma-separated member IDs
  memberNames String? // "James Smith, Linda Brown" — comma-separated member names

  // Scores
  accuracy     Float @default(0)
  presentation Float @default(0)
  totalScore   Float @default(0)
  rank         Int?

  assignedForms String? // Forms to perform in this match (e.g. "Taegeuk 4")

  status String @default("Pending") // Pending, Completed
  court  String @default("Unassigned")

  createdAt DateTime @default(now())

  @@index([categoryRefId])
  @@index([round])
  @@index([nextMatchId])
}

// Organization approval is now handled via Organization.status field
// OrganizationInvite model has been removed

model ClubAssistantInvite {
  id        String   @id @default(cuid())
  email     String   @unique
  clubName  String // The club they are being invited to
  invitedBy String // Club Master ID who created invite (User ID)
  createdAt DateTime @default(now())
}

model TournamentManagerInvite {
  id           String     @id @default(cuid())
  email        String
  token        String     @unique @default(uuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  invitedBy    String // Organizer ID (User ID)
  createdAt    DateTime   @default(now())

  @@unique([email, tournamentId]) // One invite per user per tournament
}

// ============================================
// API KEYS (Electron Security)
// ============================================

model ApiKey {
  id          String   @id @default(cuid())
  key         String   @unique // The secret key (e.g. "ktm_live_...")
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id])
  description String? // e.g. "Court Laptop 1"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// ============================================
// PUSH NOTIFICATIONS
// ============================================

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @db.Text
  p256dh    String // Public key
  auth      String // Auth secret
  createdAt DateTime @default(now())

  @@unique([userId, endpoint])
  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  url       String? // Where to navigate when clicked
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

// ============================================
// CLUB EVENT PARTICIPATION
// ============================================

model ClubEventParticipation {
  id     String @id @default(cuid())
  clubId String
  club   Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  // Relations (Only one should be set per record)
  tournamentId String?
  tournament   Tournament? @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  promotionTestId String?
  promotionTest   PromotionTest? @relation(fields: [promotionTestId], references: [id], onDelete: Cascade)

  seminarId String?
  seminar   Seminar? @relation(fields: [seminarId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  @@unique([clubId, tournamentId])
  @@unique([clubId, promotionTestId])
  @@unique([clubId, seminarId])
  @@index([clubId])
}

// ============================================
// SMART TOURNAMENT MANAGER
// ============================================

model SmartProposal {
  id           String   @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  type   String // "UNCONTESTED", "MERGE", "SPLIT"
  status String @default("PENDING") // PENDING, APPROVED, REJECTED, COMPLETED

  // JSON Data to store context (e.g. { sourceCategoryId, targetCategoryId, playerIds })
  data String @db.Text 

  votes SmartProposalVote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tournamentId])
  @@index([status])
}

model SmartProposalVote {
  id         String @id @default(cuid())
  proposalId String
  proposal   SmartProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  clubId String
  vote   String // "AGREE", "DISAGREE", "MOVE_UP", "WALKOVER", "WITHDRAW"
  
  timestamp DateTime @default(now())

  @@unique([proposalId, clubId])
}

// ============================================
// EVENT LANDING PAGE – GUEST REGISTRATION
// ============================================

model GuestRegistration {
  id               String   @id @default(cuid())
  registrationCode String   @unique // Unique code for QR / status lookup (e.g. "EVT-84721")

  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  playerId String @unique
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  // Guest details (snapshot at registration time)
  email     String
  fullName  String
  birthday  DateTime
  beltRank  String
  weightKg  Float
  heightCm  Float
  gender    String
  country   String

  // Club selection
  clubId        String? // FK to existing Club if selected
  club          Club?   @relation(fields: [clubId], references: [id])
  clubNameOther String? // Free-text if "Other" selected
  isIndependent Boolean @default(false)

  // Waiver
  waiverAccepted   Boolean   @default(false)
  waiverAcceptedAt DateTime?

  // Promo code
  promoCodeId    String?
  promoCode      PromoCode? @relation(fields: [promoCodeId], references: [id])
  discountApplied Float?

  // Bulk registration link
  bulkRegistrationId String?
  bulkRegistration   BulkRegistration? @relation(fields: [bulkRegistrationId], references: [id])

  createdAt DateTime @default(now())

  @@index([tournamentId])
  @@index([email])
  @@index([bulkRegistrationId])
}

model PromoCode {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  code          String // e.g. "EARLYBIRD20"
  discountType  String // "PERCENTAGE" or "FIXED"
  discountValue Float  // 20 (= 20% or 20 PHP depending on type)
  maxUses       Int?   // null = unlimited
  currentUses   Int    @default(0)
  validFrom     DateTime
  validUntil    DateTime
  isActive      Boolean  @default(true)

  guestRegistrations GuestRegistration[]

  createdAt DateTime @default(now())

  @@unique([tournamentId, code])
  @@index([tournamentId])
}

model BulkRegistration {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  clubId      String?
  club        Club?   @relation(fields: [clubId], references: [id])
  clubName    String
  managerEmail String
  managerName  String

  totalAthletes Int     @default(0)
  totalAmount   Float   @default(0)
  paymentStatus String  @default("UNPAID") // UNPAID, PENDING, PAID, EXPIRED

  // Xendit Payment
  xenditInvoiceId  String? @unique
  xenditPaymentUrl String?

  guestRegistrations GuestRegistration[]

  createdAt DateTime @default(now())

  @@index([tournamentId])
}

// ============================================
// GLOBAL RANKING VIEW
// ============================================
view GlobalAthleteRanking {
  id                   String @id
  userId               String
  playerName           String
  clubName             String?
  organizationId       String?
  parentOrganizationId String?
  division             String?
  gender               String?
  type                 String
  totalPoints          Float
  globalRank           Int

  @@map("GlobalAthleteRanking")
}

// ============================================
// CLUB AFFILIATION
// ============================================
model ClubAffiliation {
  id              String   @id @default(cuid())
  clubId          String
  club            Club     @relation(fields: [clubId], references: [id])
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])

  status          String   @default("UNPAID") // UNPAID, ACTIVE, EXPIRED
  amountPaid      Float?
  paidAt          DateTime?
  expiresAt       DateTime?

  // Payment
  xenditInvoiceId String?
  paymentStatus   String?  @default("UNPAID") // UNPAID, PENDING, PAID
  paymentMethod   String?  // "xendit" | "manual"

  // Proof of Payment (manual)
  proofImageUrl   String?  // Uploaded receipt/proof image
  proofSubmittedAt DateTime?
  reviewedBy      String?  // User ID of org admin who reviewed
  reviewedAt      DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([clubId, organizationId])
  @@index([status])
  @@index([expiresAt])
}
