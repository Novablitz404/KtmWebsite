// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// GUIDELINE TEMPLATE SYSTEM
// ============================================

model GuidelineTemplate {
  id          String   @id @default(cuid())
  name        String   @unique  // "Tap Elite 2026", "WTF Standard"
  pdfUrl      String?  // Uploaded PDF path/URL
  content     String?  @db.Text // Markdown/HTML content for dynamic generation
  createdAt   DateTime @default(now())
  
  divisions   Division[]
  tournaments Tournament[]
}

model Division {
  id           String   @id @default(cuid())
  name         String   // "Cadet", "Junior", "Senior"
  minAge       Int      // Minimum age for this division
  maxAge       Int      // Maximum age for this division
  displayOrder Int      @default(0)  // For sorted display
  
  templateId   String
  template     GuidelineTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  
  categories   WeightCategory[]
  
  @@index([templateId])
}

model WeightCategory {
  id          String   @id @default(cuid())
  name        String   // "FIN", "Under 58kg"
  gender      String   // "Male", "Female", "Both"
  minWeight   Float    // Minimum weight (inclusive)
  maxWeight   Float    // Maximum weight (exclusive, 999 for "and over")
  displayOrder Int     @default(0)
  
  divisionId  String
  division    Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)
}

// ============================================
// TOURNAMENT
// ============================================

model Tournament {
  id                  String     @id @default(cuid())
  name                String
  organizerId         String?
  organizer           User?      @relation("OrganizerTournaments", fields: [organizerId], references: [id])
  managers            User[]     @relation("TournamentManagers")
  startDate           DateTime   @default(now())
  venue               String?    // Location of the tournament
  registrationStart   DateTime?  // When registration opens
  registrationEnd     DateTime?  // When registration closes
  guidelinePdfUrl     String?    // URL to uploaded guideline PDF
  headerImageUrl      String?    // URL to uploaded header image
  status              String     @default("UPCOMING") // UPCOMING, ONGOING, COMPLETED, CANCELLED, RESCHEDULED
  
  // Guideline Template (optional - if set, auto-generates categories)
  guidelineTemplateId String?
  guidelineTemplate   GuidelineTemplate? @relation(fields: [guidelineTemplateId], references: [id])
  
  categories          Category[]
  managerInvites      TournamentManagerInvite[] // Relation for pending invites
}

model Category {
  id           String     @id @default(cuid())
  name         String
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  players      Player[]
  matches      Match[]
  
  type         String     @default("KYORUGI") // "KYORUGI", "POOMSAE"
  court        String?    // Assigned Court Number
  
  @@index([tournamentId])
}

// ============================================
// USER & PLAYER
// ============================================

model User {
  id        String    @id // 5-digit random ID like "00123"
  clerkId   String    @unique
  email     String    @unique
  role      String    @default("ATHLETE") // ATHLETE, CLUB_MASTER, ASSISTANT_CLUB_MASTER, ORGANIZER, MANAGER
  
  // Profile Fields
  name      String?
  birthDate DateTime? // For calculating age/division
  belt      String?
  gender    String?
  weight    Float?
  height    Float?    // Height in cm for Toddler/Grade School divisions
  clubName  String?
  
  // Face Recognition (for attendance)
  faceDescriptor String?  // JSON array of 128 floats for face recognition
  
  // Relations
  players   Player[]
  club      Club?
  organization Organization?

  // Organizer Relations
  createdTournaments Tournament[] @relation("OrganizerTournaments")
  managedTournaments Tournament[] @relation("TournamentManagers")
  
  // API Keys
  apiKeys   ApiKey[]
  
  // Attendance Records
  attendanceRecords AttendanceRecord[]
  
  // Push Notifications
  pushSubscriptions PushSubscription[]
  notifications     Notification[]
}

model Player {
  id         String   @id // 5-digit ID like "00123"
  name       String
  gender     String   @default("Male")
  weight     Float?
  belt       String?  @default("Black")
  height     Float? // Added for player specifics
  division   String?  // NEW: "Cadet", "Junior", etc.
  
  registrationStatus String @default("PENDING") // PENDING, APPROVED, REJECTED
  skillLevel String?  @default("Novice")
  
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])

  clubId     String?
  club       Club?    @relation(fields: [clubId], references: [id])

  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
  
  @@index([userId])
  @@index([categoryId])
  @@index([clubId])
}

model Club {
  id        String   @id @default(cuid())
  name      String
  masterId  String   @unique
  master    User     @relation(fields: [masterId], references: [id])
  students  Player[]
  logoUrl   String?
  address   String?
  phone     String?
  
  // Organization Relation
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  
  // Kiosk Access Control
  kioskToken String?  @unique  // Secret URL token for kiosk access
  kioskPin   String?           // 6-digit PIN for kiosk entry
  
  // Attendance
  attendanceRecords AttendanceRecord[]
}

model Organization {
  id            String   @id @default(cuid())
  name          String
  ownerId       String   @unique
  owner         User     @relation(fields: [ownerId], references: [id])
  establishedAt DateTime @default(now())
  logoUrl       String?
  
  // Organization Details
  chairman      String?
  viceChairman  String?
  address       String?
  contactEmail  String?
  contactPhone  String?
  website       String?

  clubs         Club[]
  
  // Organization Affiliates
  parentOrganizationId String?
  parentOrganization   Organization?  @relation("OrganizationAffiliates", fields: [parentOrganizationId], references: [id])
  affiliatedOrganizations Organization[] @relation("OrganizationAffiliates")
  
  announcements Announcement[]
  promotionTests PromotionTest[]
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Announcement {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  content        String   @db.Text
  priority       String   @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  createdAt      DateTime @default(now())
  expiresAt      DateTime?
  
  @@index([organizationId, createdAt])
}

model PromotionTest {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  name           String   // "January 2026 Belt Test"
  description    String?  @db.Text
  testDate       DateTime
  registrationDeadline DateTime?
  venue          String?
  fee            Float?   // Registration fee
  status         String   @default("UPCOMING") // UPCOMING, OPEN, CLOSED, COMPLETED, CANCELLED
  
  visibility     String   @default("PRIVATE") // PRIVATE, PUBLIC
  bannerUrl      String?  // Storage URL for banner image
  
  registrations  PromotionTestRegistration[]
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  @@index([organizationId, testDate])
}

model PromotionTestRegistration {
  id              String   @id @default(cuid())
  promotionTestId String
  promotionTest   PromotionTest @relation(fields: [promotionTestId], references: [id], onDelete: Cascade)
  
  playerId        String?  // If registered player
  playerName      String   // Name for display
  clubName        String?
  currentBelt     String
  targetBelt      String
  
  status          String   @default("PENDING") // PENDING, APPROVED, PASSED, FAILED
  paymentStatus   String   @default("UNPAID") // UNPAID, PAID
  
  createdAt       DateTime @default(now())
  
  @@index([promotionTestId])
}

// ============================================
// MATCH / BRACKET
// ============================================

model Match {
  id Int @id @default(autoincrement())

  category     String?
  categoryRef  Category? @relation(fields: [categoryRefId], references: [id])
  categoryRefId String?

  round Int

  player1 String
  player2 String

  winner String?

  status String @default("Pending")

  nextMatchId   Int?
  nextMatch     Match?  @relation("Bracket", fields: [nextMatchId], references: [id])
  prevMatches   Match[] @relation("Bracket")
  nextMatchSlot String?

  court String @default("Unassigned")

  // Scoring Fields
  r1_blue_score  Int @default(0)
  r1_red_score   Int @default(0)
  r2_blue_score  Int @default(0)
  r2_red_score   Int @default(0)
  r3_blue_score  Int @default(0)
  r3_red_score   Int @default(0)
  total_blue_score Int @default(0)
  total_red_score  Int @default(0)
  blue_gam_jeom   Int @default(0)
  red_gam_jeom    Int @default(0)
  blue_rounds_won Int @default(0)
  red_rounds_won  Int @default(0)
  
  @@index([categoryRefId])
}

// ============================================
// ORGANIZER INVITES
// ============================================

model OrganizationInvite {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?  // Optional: Pre-fill name for the user
  createdAt DateTime @default(now())
  invitedBy String   // Admin user ID who created invite
}

model ClubMasterInvite {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
  invitedBy String   // Admin user ID who created invite
}

model ClubAssistantInvite {
  id        String   @id @default(cuid())
  email     String   @unique
  clubName  String   // The club they are being invited to
  invitedBy String   // Club Master ID who created invite (User ID)
  createdAt DateTime @default(now())
}

model TournamentManagerInvite {
  id           String   @id @default(cuid())
  email        String
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  invitedBy    String   // Organizer ID (User ID)
  createdAt    DateTime @default(now())

  @@unique([email, tournamentId]) // One invite per user per tournament
}

// ============================================
// API KEYS (Electron Security)
// ============================================

model ApiKey {
  id          String   @id @default(cuid())
  key         String   @unique // The secret key (e.g. "ktm_live_...")
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id])
  description String?  // e.g. "Court Laptop 1"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// ============================================
// ATTENDANCE (Face Recognition)
// ============================================

model AttendanceRecord {
  id          String   @id @default(cuid())
  
  clubId      String
  club        Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  date        DateTime @db.Date  // Date only (for unique constraint)
  checkInTime DateTime @default(now())  // Exact check-in timestamp
  confidence  Float?   // Face match confidence (0-1)
  
  @@unique([clubId, userId, date])  // One check-in per day per user per club
  @@index([clubId, date])
  @@index([userId])
}

// ============================================
// PUSH NOTIFICATIONS
// ============================================

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @db.Text
  p256dh    String   // Public key
  auth      String   // Auth secret
  createdAt DateTime @default(now())
  
  @@unique([userId, endpoint])
  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  url       String?  // Where to navigate when clicked
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  
  @@index([userId, read])
  @@index([userId, createdAt])
}
